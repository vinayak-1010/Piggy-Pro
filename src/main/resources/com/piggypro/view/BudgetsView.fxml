<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.piggypro.controller.BudgetsController"
            fx:id="budgetsRoot"
            styleClass="dashboard-root"
            stylesheets="@../css/app.css">

    <!-- ════════════════════════════
         SIDEBAR
    ════════════════════════════ -->
    <left>
        <VBox styleClass="sidebar">

            <HBox styleClass="sidebar-logo-area" alignment="CENTER_LEFT" spacing="10.0">
                <StackPane styleClass="sidebar-logo-box">
                    <ImageView fx:id="sidebarLogoIcon" fitWidth="18.0" fitHeight="18.0" preserveRatio="true"/>
                </StackPane>
                <Label styleClass="sidebar-app-name" text="Piggy Pro"/>
            </HBox>

            <Label styleClass="nav-section" text="MAIN MENU"/>

            <Button fx:id="navOverview" styleClass="nav-btn" text="Overview" onAction="#handleNavOverview">
                <graphic><ImageView fx:id="iconOverview" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>
            <Button fx:id="navTransactions" styleClass="nav-btn" text="Transactions" onAction="#handleNavTransactions">
                <graphic><ImageView fx:id="iconTransactions" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>
            <Button fx:id="navAnalytics" styleClass="nav-btn" text="Analytics" onAction="#handleNavAnalytics">
                <graphic><ImageView fx:id="iconAnalytics" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>
            <Button fx:id="navBudgets" styleClass="nav-btn,active" text="Budgets" onAction="#handleNavBudgets">
                <graphic><ImageView fx:id="iconBudgets" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>
            <Button fx:id="navReports" styleClass="nav-btn" text="Reports" onAction="#handleNavReports">
                <graphic><ImageView fx:id="iconReports" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <Label styleClass="nav-section" text="PREFERENCES"/>

            <Button fx:id="navSettings" styleClass="nav-btn" text="Settings" onAction="#handleNavSettings">
                <graphic><ImageView fx:id="iconSettings" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>
            <Button fx:id="navHelp" styleClass="nav-btn" text="Help Center" onAction="#handleNavHelp">
                <graphic><ImageView fx:id="iconHelp" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>

            <VBox styleClass="sidebar-bottom-area">
                <Button fx:id="btnExport" styleClass="nav-btn,export" text="Export Data" onAction="#handleExport">
                    <graphic><ImageView fx:id="iconExport" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                </Button>
            </VBox>

        </VBox>
    </left>

    <!-- ════════════════════════════
         CENTER
    ════════════════════════════ -->
    <center>
        <VBox>

            <!-- TOPBAR -->
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="12.0">
                <HBox styleClass="search-box" alignment="CENTER_LEFT" spacing="7.0">
                    <ImageView fx:id="searchIcon" fitWidth="13.0" fitHeight="13.0"
                               preserveRatio="true" styleClass="field-icon"/>
                    <TextField fx:id="searchField" styleClass="search-field"
                               promptText="Search transactions..."
                               HBox.hgrow="ALWAYS"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane>
                    <Button fx:id="notifBtn" styleClass="notif-btn" onAction="#handleNotifications">
                        <graphic><ImageView fx:id="notifIcon" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                    </Button>
                    <Circle fx:id="notifDot" styleClass="notif-dot"
                            radius="3.5" translateX="8.0" translateY="-8.0"/>
                </StackPane>
                <HBox styleClass="user-chip" alignment="CENTER_LEFT" spacing="7.0">
                    <StackPane styleClass="user-avatar">
                        <Label fx:id="avatarInitials" styleClass="avatar-initials" text="VS"/>
                    </StackPane>
                    <Label fx:id="userDisplayName" styleClass="user-display-name" text="Vinayak"/>
                    <ImageView fx:id="chevronIcon" fitWidth="12.0" fitHeight="12.0"
                               preserveRatio="true" styleClass="field-icon"/>
                </HBox>
            </HBox>

            <!-- SCROLLABLE CONTENT -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        styleClass="content-scroll"
                        hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <content>
                    <VBox styleClass="content-area" spacing="14.0">

                        <!-- PAGE HEADER -->
                        <HBox alignment="CENTER_LEFT">
                            <VBox spacing="0.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="page-title" text="Budgets"/>
                                <Label styleClass="page-subtitle"
                                       text="Set limits and track spending by category"/>
                            </VBox>
                            <Button fx:id="setBudgetBtn" styleClass="add-txn-btn"
                                    text="Set Budget" onAction="#handleToggleForm">
                                <graphic><ImageView fx:id="addIcon" fitWidth="14.0" fitHeight="14.0" preserveRatio="true"/></graphic>
                            </Button>
                        </HBox>

                        <!-- MONTH SELECTOR -->
                        <HBox styleClass="month-bar" alignment="CENTER_LEFT" spacing="10.0">
                            <Button styleClass="month-nav-btn" onAction="#handlePrevMonth">
                                <graphic><ImageView fx:id="prevMonthIcon" fitWidth="13.0" fitHeight="13.0" preserveRatio="true"/></graphic>
                            </Button>
                            <Label fx:id="monthNameLabel" styleClass="month-name-label" text="March 2026"/>
                            <Button styleClass="month-nav-btn" onAction="#handleNextMonth">
                                <graphic><ImageView fx:id="nextMonthIcon" fitWidth="13.0" fitHeight="13.0" preserveRatio="true"/></graphic>
                            </Button>

                            <Region HBox.hgrow="ALWAYS"/>

                            <!-- Summary -->
                            <VBox spacing="1.0" alignment="CENTER_RIGHT">
                                <Label styleClass="month-summary-label" text="TOTAL BUDGET"/>
                                <Label fx:id="summaryTotalBudget" styleClass="month-summary-value" text="Rs. 0"/>
                            </VBox>
                            <Region styleClass="month-summary-sep"/>
                            <VBox spacing="1.0" alignment="CENTER_RIGHT">
                                <Label styleClass="month-summary-label" text="TOTAL SPENT"/>
                                <Label fx:id="summaryTotalSpent" styleClass="month-summary-value-red" text="Rs. 0"/>
                            </VBox>
                            <Region styleClass="month-summary-sep"/>
                            <VBox spacing="1.0" alignment="CENTER_RIGHT">
                                <Label styleClass="month-summary-label" text="REMAINING"/>
                                <Label fx:id="summaryRemaining" styleClass="month-summary-value-green" text="Rs. 0"/>
                            </VBox>
                        </HBox>

                        <!-- OVERALL BUDGET CARD -->
                        <HBox styleClass="overall-budget-card" alignment="CENTER_LEFT" spacing="20.0">
                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="overall-label" text="Overall Monthly Budget"/>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <Label fx:id="overallSpentLabel" styleClass="overall-value" text="Rs. 0"/>
                                    <Label fx:id="overallLimitLabel" styleClass="overall-sub" text="/ Rs. 0"/>
                                </HBox>
                                <Label fx:id="overallSubLabel" styleClass="overall-sub"
                                       text="0% used  •  Rs. 0 remaining"/>
                                <Region prefHeight="6.0"/>
                                <StackPane styleClass="overall-track" alignment="CENTER_LEFT">
                                    <Region fx:id="overallFill" styleClass="overall-fill" prefHeight="8.0"/>
                                </StackPane>
                            </VBox>
                            <VBox spacing="2.0" alignment="CENTER_RIGHT">
                                <Label styleClass="overall-days-label" text="Days left"/>
                                <Label fx:id="daysLeftLabel" styleClass="overall-days-value" text="0"/>
                                <Label styleClass="overall-days-label" text="in month"/>
                            </VBox>
                        </HBox>

                        <!-- INLINE ADD/EDIT FORM -->
                        <VBox fx:id="budgetFormCard" styleClass="budget-form-card"
                              spacing="14.0" visible="false" managed="false">

                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <StackPane styleClass="form-section-icon">
                                    <ImageView fx:id="formHeaderIcon" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/>
                                </StackPane>
                                <VBox spacing="0.0" HBox.hgrow="ALWAYS">
                                    <Label fx:id="formHeadingLabel" styleClass="form-section-title" text="Set New Budget"/>
                                    <Label styleClass="form-section-sub" text="Define a spending limit for a category"/>
                                </VBox>
                                <Button styleClass="eye-btn" onAction="#handleToggleForm">
                                    <graphic><ImageView fx:id="closeIcon" fitWidth="16.0" fitHeight="16.0" preserveRatio="true"/></graphic>
                                </Button>
                            </HBox>

                            <Region styleClass="form-divider" maxWidth="Infinity"/>

                            <!-- Form row: Category | Amount | Month -->
                            <HBox spacing="12.0">
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="form-field-label" text="Category"/>
                                    <ComboBox fx:id="fieldCategory" styleClass="form-combo" maxWidth="Infinity"/>
                                </VBox>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="form-field-label" text="Monthly Limit (Rs.)"/>
                                    <TextField fx:id="fieldLimit" styleClass="form-input" promptText="e.g. 5000"/>
                                </VBox>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="form-field-label" text="Month"/>
                                    <ComboBox fx:id="fieldMonth" styleClass="form-combo" maxWidth="Infinity"/>
                                </VBox>
                            </HBox>

                            <Label fx:id="formError" styleClass="error-label" text="" wrapText="true"/>

                            <HBox spacing="10.0" alignment="CENTER_RIGHT">
                                <Button styleClass="btn-cancel" text="Cancel" onAction="#handleToggleForm"/>
                                <Button fx:id="btnSave" styleClass="btn-save"
                                        text="Save Budget" onAction="#handleSave"/>
                            </HBox>

                        </VBox>

                        <!-- BUDGET CARDS — populated dynamically by controller -->
                        <!-- Using a VBox of HBox rows (3 per row) so layout is JavaFX-friendly -->
                        <VBox fx:id="budgetGridContainer" spacing="14.0"/>

                        <Region prefHeight="8.0"/>

                    </VBox>
                </content>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>
