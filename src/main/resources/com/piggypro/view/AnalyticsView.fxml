<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.piggypro.controller.AnalyticsController"
            fx:id="analyticsRoot"
            styleClass="dashboard-root"
            stylesheets="@../css/app.css">

    <!-- ════════════════════════════
         SIDEBAR
    ════════════════════════════ -->
    <left>
        <VBox styleClass="sidebar">

            <HBox styleClass="sidebar-logo-area" alignment="CENTER_LEFT" spacing="10.0">
                <StackPane styleClass="sidebar-logo-box">
                    <ImageView fx:id="sidebarLogoIcon"
                               fitWidth="18.0" fitHeight="18.0" preserveRatio="true"/>
                </StackPane>
                <Label styleClass="sidebar-app-name" text="Piggy Pro"/>
            </HBox>

            <Label styleClass="nav-section" text="MAIN MENU"/>

            <Button fx:id="navOverview" styleClass="nav-btn"
                    text="Overview" onAction="#handleNavOverview">
                <graphic><ImageView fx:id="iconOverview" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>

            <Button fx:id="navTransactions" styleClass="nav-btn"
                    text="Transactions" onAction="#handleNavTransactions">
                <graphic><ImageView fx:id="iconTransactions" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>

            <Button fx:id="navAnalytics" styleClass="nav-btn,active"
                    text="Analytics" onAction="#handleNavAnalytics">
                <graphic><ImageView fx:id="iconAnalytics" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>

            <Button fx:id="navBudgets" styleClass="nav-btn"
                    text="Budgets" onAction="#handleNavBudgets">
                <graphic><ImageView fx:id="iconBudgets" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>

            <Button fx:id="navReports" styleClass="nav-btn"
                    text="Reports" onAction="#handleNavReports">
                <graphic><ImageView fx:id="iconReports" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <Label styleClass="nav-section" text="PREFERENCES"/>

            <Button fx:id="navSettings" styleClass="nav-btn"
                    text="Settings" onAction="#handleNavSettings">
                <graphic><ImageView fx:id="iconSettings" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>

            <Button fx:id="navHelp" styleClass="nav-btn"
                    text="Help Center" onAction="#handleNavHelp">
                <graphic><ImageView fx:id="iconHelp" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>

            <VBox styleClass="sidebar-bottom-area">
                <Button fx:id="btnExport" styleClass="nav-btn,export"
                        text="Export Data" onAction="#handleExport">
                    <graphic><ImageView fx:id="iconExport" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                </Button>
            </VBox>

        </VBox>
    </left>

    <!-- ════════════════════════════
         CENTER
    ════════════════════════════ -->
    <center>
        <VBox>

            <!-- ── TOPBAR ── -->
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="12.0">
                <HBox styleClass="search-box" alignment="CENTER_LEFT" spacing="7.0">
                    <ImageView fx:id="searchIcon" fitWidth="13.0" fitHeight="13.0"
                               preserveRatio="true" styleClass="field-icon"/>
                    <TextField fx:id="searchField"
                               styleClass="search-field"
                               promptText="Search transactions..."
                               HBox.hgrow="ALWAYS"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane>
                    <Button fx:id="notifBtn" styleClass="notif-btn"
                            onAction="#handleNotifications">
                        <graphic>
                            <ImageView fx:id="notifIcon" fitWidth="15.0" fitHeight="15.0"
                                       preserveRatio="true"/>
                        </graphic>
                    </Button>
                    <Circle fx:id="notifDot" styleClass="notif-dot"
                            radius="3.5" translateX="8.0" translateY="-8.0"/>
                </StackPane>
                <HBox styleClass="user-chip" alignment="CENTER_LEFT" spacing="7.0">
                    <StackPane styleClass="user-avatar">
                        <Label fx:id="avatarInitials" styleClass="avatar-initials" text="VS"/>
                    </StackPane>
                    <Label fx:id="userDisplayName" styleClass="user-display-name" text="Vinayak"/>
                    <ImageView fx:id="chevronIcon" fitWidth="12.0" fitHeight="12.0"
                               preserveRatio="true" styleClass="field-icon"/>
                </HBox>
            </HBox>

            <!-- ── SCROLLABLE CONTENT ── -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        styleClass="content-scroll"
                        hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <content>
                    <VBox styleClass="content-area" spacing="14.0">

                        <!-- PAGE HEADER -->
                        <HBox alignment="CENTER_LEFT">
                            <VBox spacing="0.0">
                                <Label styleClass="page-title" text="Analytics"/>
                                <Label styleClass="page-subtitle"
                                       text="Visual breakdown of your spending patterns"/>
                            </VBox>
                        </HBox>

                        <!-- ── DATE RANGE BAR ── -->
                        <HBox styleClass="range-bar" alignment="CENTER_LEFT" spacing="8.0">

                            <Label styleClass="range-section-label" text="PERIOD"/>

                            <Button fx:id="btnRange7d"
                                    styleClass="range-preset-btn"
                                    text="7 Days"
                                    onAction="#handleRange7d"/>
                            <Button fx:id="btnRange30d"
                                    styleClass="range-preset-btn,active"
                                    text="30 Days"
                                    onAction="#handleRange30d"/>
                            <Button fx:id="btnRange3m"
                                    styleClass="range-preset-btn"
                                    text="3 Months"
                                    onAction="#handleRange3m"/>
                            <Button fx:id="btnRange6m"
                                    styleClass="range-preset-btn"
                                    text="6 Months"
                                    onAction="#handleRange6m"/>
                            <Button fx:id="btnRange1y"
                                    styleClass="range-preset-btn"
                                    text="1 Year"
                                    onAction="#handleRange1y"/>

                            <Region styleClass="filter-sep"/>

                            <DatePicker fx:id="dateFrom"
                                        styleClass="filter-date"
                                        promptText="From"/>
                            <Label styleClass="filter-range-label" text="to"/>
                            <DatePicker fx:id="dateTo"
                                        styleClass="filter-date"
                                        promptText="To"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button fx:id="btnApply"
                                    styleClass="range-apply-btn"
                                    text="Apply"
                                    onAction="#handleApply"/>
                        </HBox>

                        <!-- ── SUMMARY STAT CARDS ── -->
                        <HBox spacing="12.0">

                            <!-- Total Spent -->
                            <VBox styleClass="analytics-stat-card" spacing="4.0" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="analytics-stat-label"
                                           text="Total Spent" HBox.hgrow="ALWAYS"/>
                                    <StackPane styleClass="analytics-stat-icon,stat-icon-red">
                                        <ImageView fx:id="iconStatSpent"
                                                   fitWidth="13.0" fitHeight="13.0"
                                                   preserveRatio="true"/>
                                    </StackPane>
                                </HBox>
                                <Label fx:id="statTotalSpent"
                                       styleClass="analytics-stat-value"
                                       text="Rs. 0"/>
                                <Label fx:id="statSpentSub"
                                       styleClass="analytics-stat-sub"
                                       text="This period"/>
                            </VBox>

                            <!-- Top Category -->
                            <VBox styleClass="analytics-stat-card" spacing="4.0" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="analytics-stat-label"
                                           text="Top Category" HBox.hgrow="ALWAYS"/>
                                    <StackPane styleClass="analytics-stat-icon,stat-icon-amber">
                                        <ImageView fx:id="iconStatTop"
                                                   fitWidth="13.0" fitHeight="13.0"
                                                   preserveRatio="true"/>
                                    </StackPane>
                                </HBox>
                                <Label fx:id="statTopCategory"
                                       styleClass="analytics-stat-value"
                                       text="—"/>
                                <Label fx:id="statTopCatSub"
                                       styleClass="analytics-stat-sub"
                                       text="Rs. 0 spent"/>
                            </VBox>

                            <!-- Avg per Day -->
                            <VBox styleClass="analytics-stat-card" spacing="4.0" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="analytics-stat-label"
                                           text="Avg per Day" HBox.hgrow="ALWAYS"/>
                                    <StackPane styleClass="analytics-stat-icon,stat-icon-blue">
                                        <ImageView fx:id="iconStatAvg"
                                                   fitWidth="13.0" fitHeight="13.0"
                                                   preserveRatio="true"/>
                                    </StackPane>
                                </HBox>
                                <Label fx:id="statAvgDay"
                                       styleClass="analytics-stat-value"
                                       text="Rs. 0"/>
                                <Label styleClass="analytics-stat-sub" text="Daily average"/>
                            </VBox>

                            <!-- Transaction Count -->
                            <VBox styleClass="analytics-stat-card" spacing="4.0" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="analytics-stat-label"
                                           text="Transactions" HBox.hgrow="ALWAYS"/>
                                    <StackPane styleClass="analytics-stat-icon,stat-icon-green">
                                        <ImageView fx:id="iconStatCount"
                                                   fitWidth="13.0" fitHeight="13.0"
                                                   preserveRatio="true"/>
                                    </StackPane>
                                </HBox>
                                <Label fx:id="statTxnCount"
                                       styleClass="analytics-stat-value"
                                       text="0"/>
                                <Label styleClass="analytics-stat-sub" text="This period"/>
                            </VBox>

                        </HBox>

                        <!-- ── CHART ROW ── -->
                        <HBox spacing="14.0" VBox.vgrow="ALWAYS">

                            <!-- Donut chart card -->
                            <VBox styleClass="analytics-chart-card" spacing="14.0"
                                  HBox.hgrow="ALWAYS" minWidth="320.0">

                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="analytics-card-title"
                                           text="Spending by Category"
                                           HBox.hgrow="ALWAYS"/>
                                    <Button styleClass="more-btn" onAction="#handleMoreDonut">
                                        <graphic>
                                            <ImageView fx:id="moreIconDonut"
                                                       fitWidth="13.0" fitHeight="13.0"
                                                       preserveRatio="true"/>
                                        </graphic>
                                    </Button>
                                </HBox>

                                <!-- Donut + legend side by side -->
                                <HBox spacing="24.0" alignment="CENTER_LEFT" VBox.vgrow="ALWAYS">

                                    <!-- Donut canvas placeholder -->
                                    <StackPane alignment="CENTER">
                                        <Region fx:id="donutChartArea"
                                                prefWidth="160.0" minWidth="160.0"
                                                maxWidth="160.0"
                                                prefHeight="160.0" minHeight="160.0"
                                                maxHeight="160.0"/>
                                        <!-- Centre labels overlaid -->
                                        <VBox alignment="CENTER" spacing="2.0">
                                            <Label fx:id="donutCenterValue"
                                                   styleClass="donut-center-value"
                                                   text="Rs.0"/>
                                            <Label styleClass="donut-center-label"
                                                   text="TOTAL"/>
                                        </VBox>
                                    </StackPane>

                                    <!-- Legend list — populated by controller -->
                                    <VBox fx:id="legendBox" spacing="9.0"
                                          HBox.hgrow="ALWAYS" alignment="CENTER_LEFT"/>

                                </HBox>
                            </VBox>

                            <!-- Bar chart card -->
                            <VBox styleClass="analytics-chart-card" spacing="14.0"
                                  HBox.hgrow="ALWAYS" minWidth="320.0">

                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="analytics-card-title"
                                           text="Monthly Spending"
                                           HBox.hgrow="ALWAYS"/>
                                    <Button styleClass="more-btn" onAction="#handleMoreBar">
                                        <graphic>
                                            <ImageView fx:id="moreIconBar"
                                                       fitWidth="13.0" fitHeight="13.0"
                                                       preserveRatio="true"/>
                                        </graphic>
                                    </Button>
                                </HBox>

                                <!-- Bar chart canvas placeholder -->
                                <Region fx:id="barChartArea"
                                        VBox.vgrow="ALWAYS"
                                        prefHeight="200.0" minHeight="180.0"/>

                            </VBox>

                        </HBox>

                        <Region prefHeight="8.0"/>

                    </VBox>
                </content>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>
