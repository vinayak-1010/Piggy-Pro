<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.piggypro.controller.TransactionsController"
            fx:id="transactionsRoot"
            styleClass="dashboard-root"
            stylesheets="@../css/app.css">

    <!-- ════════════════════════════
         SIDEBAR  (LEFT)
    ════════════════════════════ -->
    <left>
        <VBox styleClass="sidebar">

            <HBox styleClass="sidebar-logo-area" alignment="CENTER_LEFT" spacing="10.0">
                <StackPane styleClass="sidebar-logo-box">
                    <ImageView fx:id="sidebarLogoIcon"
                               fitWidth="18.0" fitHeight="18.0"
                               preserveRatio="true"/>
                </StackPane>
                <Label styleClass="sidebar-app-name" text="Piggy Pro"/>
            </HBox>

            <Label styleClass="nav-section" text="MAIN MENU"/>

            <Button fx:id="navOverview" styleClass="nav-btn"
                    text="Overview" onAction="#handleNavOverview">
                <graphic><ImageView fx:id="iconOverview" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>

            <Button fx:id="navTransactions" styleClass="nav-btn,active"
                    text="Transactions" onAction="#handleNavTransactions">
                <graphic><ImageView fx:id="iconTransactions" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>

            <Button fx:id="navAnalytics" styleClass="nav-btn"
                    text="Analytics" onAction="#handleNavAnalytics">
                <graphic><ImageView fx:id="iconAnalytics" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>

            <Button fx:id="navBudgets" styleClass="nav-btn"
                    text="Budgets" onAction="#handleNavBudgets">
                <graphic><ImageView fx:id="iconBudgets" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>

            <Button fx:id="navReports" styleClass="nav-btn"
                    text="Reports" onAction="#handleNavReports">
                <graphic><ImageView fx:id="iconReports" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <Label styleClass="nav-section" text="PREFERENCES"/>

            <Button fx:id="navSettings" styleClass="nav-btn"
                    text="Settings" onAction="#handleNavSettings">
                <graphic><ImageView fx:id="iconSettings" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>

            <Button fx:id="navHelp" styleClass="nav-btn"
                    text="Help Center" onAction="#handleNavHelp">
                <graphic><ImageView fx:id="iconHelp" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>

            <VBox styleClass="sidebar-bottom-area">
                <Button fx:id="btnExport" styleClass="nav-btn,export"
                        text="Export Data" onAction="#handleExport">
                    <graphic><ImageView fx:id="iconExport" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                </Button>
            </VBox>

        </VBox>
    </left>

    <!-- ════════════════════════════
         CENTER
    ════════════════════════════ -->
    <center>
        <VBox>

            <!-- ── TOPBAR ── -->
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="12.0">
                <HBox styleClass="search-box" alignment="CENTER_LEFT" spacing="7.0">
                    <ImageView fx:id="searchIcon" fitWidth="13.0" fitHeight="13.0"
                               preserveRatio="true" styleClass="field-icon"/>
                    <TextField fx:id="topSearchField"
                               styleClass="search-field"
                               promptText="Search transactions..."
                               HBox.hgrow="ALWAYS"
                               onKeyReleased="#handleTopSearch"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane>
                    <Button fx:id="notifBtn" styleClass="notif-btn" onAction="#handleNotifications">
                        <graphic><ImageView fx:id="notifIcon" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                    </Button>
                    <Circle fx:id="notifDot" styleClass="notif-dot"
                            radius="3.5" translateX="8.0" translateY="-8.0"/>
                </StackPane>
                <HBox styleClass="user-chip" alignment="CENTER_LEFT" spacing="7.0">
                    <StackPane styleClass="user-avatar">
                        <Label fx:id="avatarInitials" styleClass="avatar-initials" text="VS"/>
                    </StackPane>
                    <Label fx:id="userDisplayName" styleClass="user-display-name" text="Vinayak"/>
                    <ImageView fx:id="chevronIcon" fitWidth="12.0" fitHeight="12.0"
                               preserveRatio="true" styleClass="field-icon"/>
                </HBox>
            </HBox>

            <!-- ── SCROLLABLE CONTENT ── -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        styleClass="content-scroll"
                        hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <content>
                    <VBox styleClass="content-area" spacing="14.0">

                        <!-- PAGE HEADER -->
                        <HBox alignment="CENTER_LEFT">
                            <VBox spacing="0.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="page-title" text="Transactions"/>
                                <Label styleClass="page-subtitle"
                                       text="Manage and track all your expenses"/>
                            </VBox>
                            <Button fx:id="addTxnBtn"
                                    styleClass="add-txn-btn"
                                    text="Add Transaction"
                                    onAction="#handleToggleForm">
                                <graphic><ImageView fx:id="addIcon" fitWidth="14.0" fitHeight="14.0" preserveRatio="true"/></graphic>
                            </Button>
                        </HBox>

                        <!-- ── INLINE ADD / EDIT FORM ── -->
                        <VBox fx:id="txnFormCard"
                              styleClass="txn-form-card"
                              spacing="14.0"
                              visible="false" managed="false">

                            <!-- Form header -->
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <StackPane styleClass="form-section-icon">
                                    <ImageView fx:id="formHeaderIcon"
                                               fitWidth="15.0" fitHeight="15.0"
                                               preserveRatio="true"/>
                                </StackPane>
                                <VBox spacing="0.0" HBox.hgrow="ALWAYS">
                                    <Label fx:id="formHeadingLabel"
                                           styleClass="form-section-title"
                                           text="Add New Transaction"/>
                                    <Label styleClass="form-section-sub"
                                           text="Fill in the details below and click Save"/>
                                </VBox>
                                <Button fx:id="closeFormBtn"
                                        styleClass="eye-btn"
                                        onAction="#handleToggleForm">
                                    <graphic><ImageView fx:id="closeIcon" fitWidth="16.0" fitHeight="16.0" preserveRatio="true"/></graphic>
                                </Button>
                            </HBox>

                            <!-- Divider -->
                            <Region styleClass="form-divider" maxWidth="Infinity"/>

                            <!-- Row 1: Description | Amount | Type -->
                            <HBox spacing="12.0">
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="form-field-label" text="Description"/>
                                    <TextField fx:id="fieldDescription"
                                               styleClass="form-input"
                                               promptText="e.g. Amazon Shopping"/>
                                </VBox>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="form-field-label" text="Amount (Rs.)"/>
                                    <TextField fx:id="fieldAmount"
                                               styleClass="form-input"
                                               promptText="0.00"/>
                                </VBox>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="form-field-label" text="Type"/>
                                    <ComboBox fx:id="fieldType"
                                              styleClass="form-combo"
                                              maxWidth="Infinity"/>
                                </VBox>
                            </HBox>

                            <!-- Row 2: Category | Date | Note -->
                            <HBox spacing="12.0">
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="form-field-label" text="Category"/>
                                    <ComboBox fx:id="fieldCategory"
                                              styleClass="form-combo"
                                              maxWidth="Infinity"/>
                                </VBox>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="form-field-label" text="Date"/>
                                    <DatePicker fx:id="fieldDate"
                                                styleClass="form-datepicker"
                                                maxWidth="Infinity"/>
                                </VBox>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="form-field-label" text="Note (optional)"/>
                                    <TextField fx:id="fieldNote"
                                               styleClass="form-input"
                                               promptText="Any additional details..."/>
                                </VBox>
                            </HBox>

                            <!-- Error label -->
                            <Label fx:id="formError"
                                   styleClass="error-label"
                                   text="" wrapText="true"/>

                            <!-- Actions -->
                            <HBox spacing="10.0" alignment="CENTER_RIGHT">
                                <Button styleClass="btn-cancel"
                                        text="Cancel"
                                        onAction="#handleToggleForm"/>
                                <Button fx:id="btnSave"
                                        styleClass="btn-save"
                                        text="Save Transaction"
                                        onAction="#handleSave"/>
                            </HBox>

                        </VBox>

                        <!-- ── FILTER BAR ── -->
                        <HBox styleClass="filter-bar" alignment="CENTER_LEFT" spacing="10.0">
                            <Label styleClass="filter-label" text="FILTER"/>

                            <ComboBox fx:id="filterCategory"
                                      styleClass="filter-combo"
                                      onAction="#applyFilters"/>
                            <ComboBox fx:id="filterType"
                                      styleClass="filter-combo"
                                      onAction="#applyFilters"/>

                            <Region styleClass="filter-sep"/>

                            <DatePicker fx:id="filterDateFrom"
                                        styleClass="filter-date"
                                        promptText="From"
                                        onAction="#applyFilters"/>
                            <Label styleClass="filter-range-label" text="to"/>
                            <DatePicker fx:id="filterDateTo"
                                        styleClass="filter-date"
                                        promptText="To"
                                        onAction="#applyFilters"/>

                            <Region styleClass="filter-sep"/>

                            <ComboBox fx:id="filterAmount"
                                      styleClass="filter-combo"
                                      onAction="#applyFilters"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button styleClass="clear-filter-btn"
                                    text="Clear filters"
                                    onAction="#handleClearFilters"/>
                        </HBox>

                        <!-- ── SUMMARY CHIPS ── -->
                        <HBox spacing="10.0">
                            <VBox styleClass="summary-chip" spacing="2.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="chip-label" text="Total Transactions"/>
                                <Label fx:id="chipTotal" styleClass="chip-value" text="0"/>
                            </VBox>
                            <VBox styleClass="summary-chip" spacing="2.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="chip-label" text="Total Expenses"/>
                                <Label fx:id="chipExpenses" styleClass="chip-value-red" text="Rs. 0"/>
                            </VBox>
                            <VBox styleClass="summary-chip" spacing="2.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="chip-label" text="Total Income"/>
                                <Label fx:id="chipIncome" styleClass="chip-value-green" text="Rs. 0"/>
                            </VBox>
                            <VBox styleClass="summary-chip" spacing="2.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="chip-label" text="Net Balance"/>
                                <Label fx:id="chipNet" styleClass="chip-value-accent" text="Rs. 0"/>
                            </VBox>
                        </HBox>

                        <!-- ── TABLE CARD ── -->
                        <VBox styleClass="table-card" VBox.vgrow="ALWAYS">

                            <!-- TableView — columns defined in controller -->
                            <TableView fx:id="transactionTable"
                                       styleClass="table-view"
                                       VBox.vgrow="ALWAYS"
                                       minHeight="220.0"/>

                            <!-- Pagination bar -->
                            <HBox styleClass="pagination-bar"
                                  alignment="CENTER_LEFT" spacing="4.0">
                                <Label fx:id="pagInfoLabel"
                                       styleClass="pag-info-label"
                                       text="Showing 0–0 of 0 transactions"
                                       HBox.hgrow="ALWAYS"/>
                                <Button fx:id="pagPrev" styleClass="pag-btn"
                                        onAction="#handlePagPrev">
                                    <graphic><ImageView fx:id="pagPrevIcon" fitWidth="12.0" fitHeight="12.0" preserveRatio="true"/></graphic>
                                </Button>
                                <Button fx:id="pagBtn1" styleClass="pag-btn,active"
                                        text="1" onAction="#handlePagBtn"/>
                                <Button fx:id="pagBtn2" styleClass="pag-btn"
                                        text="2" onAction="#handlePagBtn"/>
                                <Button fx:id="pagBtn3" styleClass="pag-btn"
                                        text="3" onAction="#handlePagBtn"/>
                                <Button fx:id="pagBtn4" styleClass="pag-btn"
                                        text="4" onAction="#handlePagBtn"/>
                                <Button fx:id="pagNext" styleClass="pag-btn"
                                        onAction="#handlePagNext">
                                    <graphic><ImageView fx:id="pagNextIcon" fitWidth="12.0" fitHeight="12.0" preserveRatio="true"/></graphic>
                                </Button>
                            </HBox>

                        </VBox>

                        <Region prefHeight="8.0"/>

                    </VBox>
                </content>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>
