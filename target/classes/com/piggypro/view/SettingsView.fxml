<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.piggypro.controller.SettingsController"
            fx:id="settingsRoot"
            styleClass="dashboard-root"
            stylesheets="@../css/app.css">

    <left>
        <VBox styleClass="sidebar">
            <HBox styleClass="sidebar-logo-area" alignment="CENTER_LEFT" spacing="10.0">
                <StackPane styleClass="sidebar-logo-box">
                    <ImageView fx:id="sidebarLogoIcon" fitWidth="18.0" fitHeight="18.0" preserveRatio="true"/>
                </StackPane>
                <Label styleClass="sidebar-app-name" text="Piggy Pro"/>
            </HBox>
            <Label styleClass="nav-section" text="MAIN MENU"/>
            <Button fx:id="navOverview"      styleClass="nav-btn" text="Overview"      onAction="#handleNavOverview">
                <graphic><ImageView fx:id="iconOverview"      fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>
            <Button fx:id="navTransactions"  styleClass="nav-btn" text="Transactions"  onAction="#handleNavTransactions">
                <graphic><ImageView fx:id="iconTransactions"  fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>
            <Button fx:id="navAnalytics"     styleClass="nav-btn" text="Analytics"     onAction="#handleNavAnalytics">
                <graphic><ImageView fx:id="iconAnalytics"     fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>
            <Button fx:id="navBudgets"       styleClass="nav-btn" text="Budgets"       onAction="#handleNavBudgets">
                <graphic><ImageView fx:id="iconBudgets"       fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>
            <Button fx:id="navReports"       styleClass="nav-btn" text="Reports"       onAction="#handleNavReports">
                <graphic><ImageView fx:id="iconReports"       fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>
            <Region VBox.vgrow="ALWAYS"/>
            <Label styleClass="nav-section" text="PREFERENCES"/>
            <Button fx:id="navSettings"      styleClass="nav-btn,active" text="Settings" onAction="#handleNavSettings">
                <graphic><ImageView fx:id="iconSettings"      fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>
            <Button fx:id="navHelp"          styleClass="nav-btn" text="Help Center"   onAction="#handleNavHelp">
                <graphic><ImageView fx:id="iconHelp"          fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>
            <VBox styleClass="sidebar-bottom-area">
                <Button fx:id="btnExport" styleClass="nav-btn,export" text="Export Data" onAction="#handleExport">
                    <graphic><ImageView fx:id="iconExport" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                </Button>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox>
            <!-- TOPBAR -->
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="12.0">
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane>
                    <Button fx:id="notifBtn" styleClass="notif-btn" onAction="#handleNotifications">
                        <graphic><ImageView fx:id="notifIcon" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                    </Button>
                    <Circle fx:id="notifDot" styleClass="notif-dot" radius="3.5" translateX="8.0" translateY="-8.0"/>
                </StackPane>
                <HBox styleClass="user-chip" alignment="CENTER_LEFT" spacing="7.0" onMouseClicked="#handleUserChip">
                    <StackPane styleClass="user-avatar">
                        <Label fx:id="avatarInitials" styleClass="avatar-initials" text="VS"/>
                    </StackPane>
                    <Label fx:id="userDisplayName" styleClass="user-display-name" text="Vinayak"/>
                    <ImageView fx:id="chevronIcon" fitWidth="12.0" fitHeight="12.0" preserveRatio="true" styleClass="field-icon"/>
                </HBox>
            </HBox>

            <!-- CONTENT -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="content-scroll"
                        hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <content>
                    <VBox styleClass="content-area" spacing="14.0">

                        <Label styleClass="page-title" text="Settings"/>
                        <Label styleClass="page-subtitle" text="Manage your profile and account preferences"/>

                        <!-- ── Profile Section ── -->
                        <VBox styleClass="settings-section-card">
                            <Label styleClass="settings-section-title" text="Profile Information"/>

                            <HBox styleClass="settings-row" alignment="CENTER_LEFT" spacing="14.0">
                                <StackPane styleClass="settings-row-icon-box" style="-fx-background-color:rgba(37,99,235,0.08);">
                                    <ImageView fx:id="iconProfile" fitWidth="16.0" fitHeight="16.0" preserveRatio="true"/>
                                </StackPane>
                                <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="settings-row-label" text="Full Name"/>
                                    <Label styleClass="settings-row-sub" text="Your display name across the app"/>
                                </VBox>
                                <TextField fx:id="fieldFullName" styleClass="form-input"
                                           promptText="Your full name" prefWidth="240.0"/>
                            </HBox>

                            <HBox styleClass="settings-row" alignment="CENTER_LEFT" spacing="14.0">
                                <StackPane styleClass="settings-row-icon-box" style="-fx-background-color:rgba(37,99,235,0.08);">
                                    <ImageView fx:id="iconEmail" fitWidth="16.0" fitHeight="16.0" preserveRatio="true"/>
                                </StackPane>
                                <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="settings-row-label" text="Username"/>
                                    <Label styleClass="settings-row-sub" text="Used to log in"/>
                                </VBox>
                                <TextField fx:id="fieldUsername" styleClass="form-input"
                                           promptText="Username" prefWidth="240.0"
                                           editable="false" opacity="0.6"/>
                            </HBox>

                            <HBox styleClass="settings-row-last" alignment="CENTER_RIGHT" spacing="10.0">
                                <Label fx:id="profileMsg" styleClass="error-label" text="" HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnSaveProfile" styleClass="settings-save-btn"
                                        text="Save Changes" onAction="#handleSaveProfile"/>
                            </HBox>
                        </VBox>

                        <!-- ── Password Section ── -->
                        <VBox styleClass="settings-section-card">
                            <Label styleClass="settings-section-title" text="Change Password"/>

                            <HBox styleClass="settings-row" alignment="CENTER_LEFT" spacing="14.0">
                                <StackPane styleClass="settings-row-icon-box" style="-fx-background-color:rgba(139,92,246,0.08);">
                                    <ImageView fx:id="iconLock" fitWidth="16.0" fitHeight="16.0" preserveRatio="true"/>
                                </StackPane>
                                <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="settings-row-label" text="Current Password"/>
                                </VBox>
                                <PasswordField fx:id="fieldCurrentPw" styleClass="form-input"
                                               promptText="Enter current password" prefWidth="240.0"/>
                            </HBox>

                            <HBox styleClass="settings-row" alignment="CENTER_LEFT" spacing="14.0">
                                <StackPane styleClass="settings-row-icon-box" style="-fx-background-color:rgba(139,92,246,0.08);">
                                    <ImageView fx:id="iconLock2" fitWidth="16.0" fitHeight="16.0" preserveRatio="true"/>
                                </StackPane>
                                <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="settings-row-label" text="New Password"/>
                                    <Label styleClass="settings-row-sub" text="Min 8 chars, 1 uppercase, 1 number, 1 special"/>
                                </VBox>
                                <PasswordField fx:id="fieldNewPw" styleClass="form-input"
                                               promptText="New password" prefWidth="240.0"/>
                            </HBox>

                            <HBox styleClass="settings-row" alignment="CENTER_LEFT" spacing="14.0">
                                <StackPane styleClass="settings-row-icon-box" style="-fx-background-color:rgba(139,92,246,0.08);">
                                    <ImageView fx:id="iconLock3" fitWidth="16.0" fitHeight="16.0" preserveRatio="true"/>
                                </StackPane>
                                <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="settings-row-label" text="Confirm New Password"/>
                                </VBox>
                                <PasswordField fx:id="fieldConfirmPw" styleClass="form-input"
                                               promptText="Repeat new password" prefWidth="240.0"/>
                            </HBox>

                            <HBox styleClass="settings-row-last" alignment="CENTER_RIGHT" spacing="10.0">
                                <Label fx:id="passwordMsg" styleClass="error-label" text="" HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnChangePassword" styleClass="settings-save-btn"
                                        text="Update Password" onAction="#handleChangePassword"/>
                            </HBox>
                        </VBox>

                        <!-- ── Account Section ── -->
                        <VBox styleClass="settings-section-card">
                            <Label styleClass="settings-section-title" text="Account"/>

                            <HBox styleClass="settings-row" alignment="CENTER_LEFT" spacing="14.0">
                                <StackPane styleClass="settings-row-icon-box" style="-fx-background-color:rgba(16,185,129,0.08);">
                                    <ImageView fx:id="iconDb" fitWidth="16.0" fitHeight="16.0" preserveRatio="true"/>
                                </StackPane>
                                <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="settings-row-label" text="Database Location"/>
                                    <Label fx:id="dbPathLabel" styleClass="settings-row-sub" text="~/PiggyPro/piggypro.db"/>
                                </VBox>
                            </HBox>

                            <HBox styleClass="settings-row-last" alignment="CENTER_LEFT" spacing="14.0">
                                <StackPane styleClass="settings-row-icon-box" style="-fx-background-color:rgba(239,68,68,0.08);">
                                    <ImageView fx:id="iconLogout" fitWidth="16.0" fitHeight="16.0" preserveRatio="true"/>
                                </StackPane>
                                <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="settings-row-label" text="Sign Out"/>
                                    <Label styleClass="settings-row-sub" text="Log out of your account"/>
                                </VBox>
                                <Button styleClass="settings-danger-btn"
                                        text="Sign Out" onAction="#handleLogout"/>
                            </HBox>
                        </VBox>

                        <Region prefHeight="8.0"/>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
