<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.piggypro.controller.DashboardController"
            fx:id="dashboardRoot"
            styleClass="dashboard-root"
            stylesheets="@../css/app.css">

    <!-- ════════════════════════════
         SIDEBAR  (LEFT)
    ════════════════════════════ -->
    <left>
        <VBox styleClass="sidebar">

            <!-- Logo area -->
            <HBox styleClass="sidebar-logo-area" alignment="CENTER_LEFT" spacing="10.0">
                <StackPane styleClass="sidebar-logo-box">
                    <ImageView fx:id="sidebarLogoIcon"
                               fitWidth="18.0" fitHeight="18.0"
                               preserveRatio="true"/>
                </StackPane>
                <Label styleClass="sidebar-app-name" text="Piggy Pro"/>
            </HBox>

            <!-- Main Menu -->
            <Label styleClass="nav-section" text="MAIN MENU"/>

            <Button fx:id="navOverview"   styleClass="nav-btn,active"
                    text="Overview"        onAction="#handleNavOverview">
                <graphic><ImageView fx:id="iconOverview" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>

            <Button fx:id="navTransactions" styleClass="nav-btn"
                    text="Transactions"    onAction="#handleNavTransactions">
                <graphic><ImageView fx:id="iconTransactions" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>

            <Button fx:id="navAnalytics"  styleClass="nav-btn"
                    text="Analytics"       onAction="#handleNavAnalytics">
                <graphic><ImageView fx:id="iconAnalytics" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>

            <Button fx:id="navBudgets"    styleClass="nav-btn"
                    text="Budgets"         onAction="#handleNavBudgets">
                <graphic><ImageView fx:id="iconBudgets" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>

            <Button fx:id="navReports"    styleClass="nav-btn"
                    text="Reports"         onAction="#handleNavReports">
                <graphic><ImageView fx:id="iconReports" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- Preferences -->
            <Label styleClass="nav-section" text="PREFERENCES"/>

            <Button fx:id="navSettings"   styleClass="nav-btn"
                    text="Settings"        onAction="#handleNavSettings">
                <graphic><ImageView fx:id="iconSettings" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>

            <Button fx:id="navHelp"       styleClass="nav-btn"
                    text="Help Center"     onAction="#handleNavHelp">
                <graphic><ImageView fx:id="iconHelp" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                <VBox.margin><Insets top="1.0" bottom="1.0" left="8.0" right="8.0"/></VBox.margin>
            </Button>

            <!-- Export -->
            <VBox styleClass="sidebar-bottom-area">
                <Button fx:id="btnExport" styleClass="nav-btn,export"
                        text="Export Data"  onAction="#handleExport">
                    <graphic><ImageView fx:id="iconExport" fitWidth="15.0" fitHeight="15.0" preserveRatio="true"/></graphic>
                </Button>
            </VBox>

        </VBox>
    </left>

    <!-- ════════════════════════════
         CENTER  (Topbar + Content)
    ════════════════════════════ -->
    <center>
        <VBox>

            <!-- ── TOPBAR ── -->
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="12.0">

                <!-- Search -->
                <HBox styleClass="search-box" alignment="CENTER_LEFT" spacing="7.0">
                    <ImageView fx:id="searchIcon"
                               fitWidth="13.0" fitHeight="13.0"
                               preserveRatio="true"
                               styleClass="field-icon"/>
                    <TextField fx:id="searchField"
                               styleClass="search-field"
                               promptText="Search transactions..."
                               HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS"/>

                <!-- Notification button -->
                <StackPane>
                    <Button fx:id="notifBtn" styleClass="notif-btn"
                            onAction="#handleNotifications">
                        <graphic>
                            <ImageView fx:id="notifIcon"
                                       fitWidth="15.0" fitHeight="15.0"
                                       preserveRatio="true"/>
                        </graphic>
                    </Button>
                    <Circle fx:id="notifDot" styleClass="notif-dot"
                            radius="3.5"
                            translateX="8.0" translateY="-8.0"/>
                </StackPane>

                <!-- User chip -->
                <HBox styleClass="user-chip" alignment="CENTER_LEFT" spacing="7.0">
                    <StackPane styleClass="user-avatar">
                        <Label fx:id="avatarInitials"
                               styleClass="avatar-initials"
                               text="VS"/>
                    </StackPane>
                    <Label fx:id="userDisplayName"
                           styleClass="user-display-name"
                           text="Vinayak"/>
                    <ImageView fx:id="chevronIcon"
                               fitWidth="12.0" fitHeight="12.0"
                               preserveRatio="true"
                               styleClass="field-icon"/>
                </HBox>

            </HBox>

            <!-- ── SCROLLABLE CONTENT ── -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        styleClass="content-scroll"
                        hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <content>
                    <VBox styleClass="content-area" spacing="14.0">

                        <!-- ── PAGE HEADER ── -->
                        <HBox alignment="CENTER_LEFT">
                            <VBox spacing="0.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="page-title" text="Overview"/>
                                <Label styleClass="page-subtitle"
                                       text="Track your spending and savings"/>
                            </VBox>
                            <HBox styleClass="date-badge" alignment="CENTER_LEFT" spacing="5.0">
                                <ImageView fx:id="calendarIcon"
                                           fitWidth="12.0" fitHeight="12.0"
                                           preserveRatio="true"
                                           styleClass="field-icon"/>
                                <Label fx:id="dateRangeLabel"
                                       styleClass="date-badge-text"
                                       text="Mar 01 – Mar 06, 2026"/>
                            </HBox>
                        </HBox>

                        <!-- ── STAT CARDS ROW ── -->
                        <HBox spacing="12.0">

                            <!-- Balance -->
                            <VBox styleClass="stat-card" spacing="4.0" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="stat-label"
                                           text="Total Balance"
                                           HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="badgeBalance"
                                           styleClass="stat-badge-up"
                                           text="+15.8%"/>
                                </HBox>
                                <Label fx:id="valueBalance"
                                       styleClass="stat-value"
                                       text="Rs. 84,250"/>
                                <Label styleClass="stat-sub"
                                       text="Across all accounts"/>
                                <!-- Sparkline rendered by controller via Canvas -->
                                <Region fx:id="sparkBalance"
                                        prefHeight="32.0" minHeight="32.0"
                                        maxHeight="32.0"/>
                            </VBox>

                            <!-- Expenses -->
                            <VBox styleClass="stat-card" spacing="4.0" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="stat-label"
                                           text="Monthly Expenses"
                                           HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="badgeExpenses"
                                           styleClass="stat-badge-down"
                                           text="-1.8%"/>
                                </HBox>
                                <Label fx:id="valueExpenses"
                                       styleClass="stat-value"
                                       text="Rs. 12,430"/>
                                <Label styleClass="stat-sub"
                                       text="214 transactions"/>
                                <Region fx:id="sparkExpenses"
                                        prefHeight="32.0" minHeight="32.0"
                                        maxHeight="32.0"/>
                            </VBox>

                            <!-- Savings -->
                            <VBox styleClass="stat-card" spacing="4.0" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="stat-label"
                                           text="Monthly Savings"
                                           HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="badgeSavings"
                                           styleClass="stat-badge-up"
                                           text="+12.5%"/>
                                </HBox>
                                <Label fx:id="valueSavings"
                                       styleClass="stat-value"
                                       text="Rs. 8,320"/>
                                <Label styleClass="stat-sub"
                                       text="Rs. 62 avg daily saved"/>
                                <Region fx:id="sparkSavings"
                                        prefHeight="32.0" minHeight="32.0"
                                        maxHeight="32.0"/>
                            </VBox>

                        </HBox>

                        <!-- ── MID ROW: Chart + Top Category ── -->
                        <HBox spacing="12.0">

                            <!-- Spending Overview chart card -->
                            <VBox styleClass="dash-card" spacing="0.0"
                                  HBox.hgrow="ALWAYS">
                                <padding><Insets top="16.0" right="18.0" bottom="14.0" left="18.0"/></padding>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <Label styleClass="card-title"
                                           text="Spending Overview"
                                           HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="periodSpending"
                                            styleClass="period-btn"
                                            text="Last 7 days"
                                            onAction="#handlePeriodSpending"/>
                                    <Button styleClass="more-btn"
                                            onAction="#handleMoreSpending">
                                        <graphic>
                                            <ImageView fx:id="moreIconSpending"
                                                       fitWidth="13.0" fitHeight="13.0"
                                                       preserveRatio="true"/>
                                        </graphic>
                                    </Button>
                                </HBox>
                                <Region prefHeight="12.0"/>
                                <!-- Chart canvas — drawn by controller -->
                                <Region fx:id="spendingChartArea"
                                        prefHeight="140.0" minHeight="140.0"
                                        maxHeight="140.0"
                                        VBox.vgrow="NEVER"/>
                            </VBox>

                            <!-- Top Category bar card -->
                            <VBox styleClass="dash-card" spacing="0.0"
                                  prefWidth="200.0" minWidth="180.0">
                                <padding><Insets top="16.0" right="18.0" bottom="14.0" left="18.0"/></padding>
                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="card-title"
                                           text="Top Category"
                                           HBox.hgrow="ALWAYS"/>
                                    <Button styleClass="more-btn"
                                            onAction="#handleMoreCategory">
                                        <graphic>
                                            <ImageView fx:id="moreIconCategory"
                                                       fitWidth="13.0" fitHeight="13.0"
                                                       preserveRatio="true"/>
                                        </graphic>
                                    </Button>
                                </HBox>
                                <Region prefHeight="10.0"/>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <Label fx:id="topCatValue"
                                           styleClass="big-stat-value"
                                           text="Rs. 4,820"/>
                                    <Label fx:id="topCatBadge"
                                           styleClass="stat-badge-up"
                                           text="+12%"/>
                                </HBox>
                                <Label fx:id="topCatHint"
                                       styleClass="big-stat-hint"
                                       text="Food and Dining  Last 7 days"/>
                                <!-- Mini bars — drawn by controller -->
                                <Region fx:id="topCatBarsArea"
                                        prefHeight="60.0" minHeight="60.0"
                                        maxHeight="60.0"
                                        VBox.vgrow="NEVER"/>
                            </VBox>

                        </HBox>

                        <!-- ── BOTTOM ROW: Transactions + Budget ── -->
                        <HBox spacing="12.0">

                            <!-- Recent Transactions -->
                            <VBox styleClass="dash-card" spacing="0.0"
                                  HBox.hgrow="ALWAYS">
                                <padding><Insets top="16.0" right="18.0" bottom="14.0" left="18.0"/></padding>
                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="card-title"
                                           text="Recent Transactions"
                                           HBox.hgrow="ALWAYS"/>
                                    <Button styleClass="view-all-btn"
                                            text="View all"
                                            onAction="#handleViewAllTransactions"/>
                                </HBox>
                                <Region prefHeight="4.0"/>

                                <!-- Row 1 -->
                                <HBox fx:id="txnRow1" styleClass="txn-row" alignment="CENTER_LEFT" spacing="10.0">
                                    <StackPane fx:id="txnIconBox1" styleClass="txn-icon-box,txn-icon-blue">
                                        <ImageView fx:id="txnIcon1" fitWidth="14.0" fitHeight="14.0" preserveRatio="true"/>
                                    </StackPane>
                                    <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                                        <Label fx:id="txnName1"     styleClass="txn-name"     text=""/>
                                        <Label fx:id="txnCategory1" styleClass="txn-category" text=""/>
                                    </VBox>
                                    <Label fx:id="txnDate1"   styleClass="txn-date"       text=""/>
                                    <Label fx:id="txnAmount1" styleClass="txn-amount-neg" text=""/>
                                </HBox>

                                <!-- Row 2 -->
                                <HBox fx:id="txnRow2" styleClass="txn-row" alignment="CENTER_LEFT" spacing="10.0">
                                    <StackPane fx:id="txnIconBox2" styleClass="txn-icon-box,txn-icon-green">
                                        <ImageView fx:id="txnIcon2" fitWidth="14.0" fitHeight="14.0" preserveRatio="true"/>
                                    </StackPane>
                                    <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                                        <Label fx:id="txnName2"     styleClass="txn-name"     text=""/>
                                        <Label fx:id="txnCategory2" styleClass="txn-category" text=""/>
                                    </VBox>
                                    <Label fx:id="txnDate2"   styleClass="txn-date"       text=""/>
                                    <Label fx:id="txnAmount2" styleClass="txn-amount-neg" text=""/>
                                </HBox>

                                <!-- Row 3 -->
                                <HBox fx:id="txnRow3" styleClass="txn-row" alignment="CENTER_LEFT" spacing="10.0">
                                    <StackPane fx:id="txnIconBox3" styleClass="txn-icon-box,txn-icon-amber">
                                        <ImageView fx:id="txnIcon3" fitWidth="14.0" fitHeight="14.0" preserveRatio="true"/>
                                    </StackPane>
                                    <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                                        <Label fx:id="txnName3"     styleClass="txn-name"     text=""/>
                                        <Label fx:id="txnCategory3" styleClass="txn-category" text=""/>
                                    </VBox>
                                    <Label fx:id="txnDate3"   styleClass="txn-date"       text=""/>
                                    <Label fx:id="txnAmount3" styleClass="txn-amount-neg" text=""/>
                                </HBox>

                                <!-- Row 4 -->
                                <HBox fx:id="txnRow4" styleClass="txn-row" alignment="CENTER_LEFT" spacing="10.0">
                                    <StackPane fx:id="txnIconBox4" styleClass="txn-icon-box,txn-icon-red">
                                        <ImageView fx:id="txnIcon4" fitWidth="14.0" fitHeight="14.0" preserveRatio="true"/>
                                    </StackPane>
                                    <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                                        <Label fx:id="txnName4"     styleClass="txn-name"     text=""/>
                                        <Label fx:id="txnCategory4" styleClass="txn-category" text=""/>
                                    </VBox>
                                    <Label fx:id="txnDate4"   styleClass="txn-date"       text=""/>
                                    <Label fx:id="txnAmount4" styleClass="txn-amount-neg" text=""/>
                                </HBox>

                            </VBox>

                            <!-- Budget Progress -->
                            <VBox styleClass="dash-card" spacing="0.0"
                                  prefWidth="280.0" minWidth="240.0">
                                <padding><Insets top="16.0" right="18.0" bottom="14.0" left="18.0"/></padding>
                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="card-title"
                                           text="Budget Progress"
                                           HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="periodBudget"
                                            styleClass="period-btn"
                                            text="March"
                                            onAction="#handlePeriodBudget"/>
                                </HBox>
                                <Region prefHeight="12.0"/>

                                <!-- Food -->
                                <VBox spacing="5.0">
                                    <HBox>
                                        <Label styleClass="budget-name" text="Food and Dining" HBox.hgrow="ALWAYS"/>
                                        <Label styleClass="budget-value" text="Rs.4,820 / Rs.6,000"/>
                                    </HBox>
                                    <StackPane styleClass="progress-track" alignment="CENTER_LEFT">
                                        <Region styleClass="progress-fill-amber"
                                                prefHeight="5.0"
                                                fx:id="budgetBarFood"/>
                                    </StackPane>
                                    <VBox.margin><Insets bottom="8.0"/></VBox.margin>
                                </VBox>

                                <!-- Transport -->
                                <VBox spacing="5.0">
                                    <HBox>
                                        <Label styleClass="budget-name" text="Transport" HBox.hgrow="ALWAYS"/>
                                        <Label styleClass="budget-value" text="Rs.1,200 / Rs.3,000"/>
                                    </HBox>
                                    <StackPane styleClass="progress-track" alignment="CENTER_LEFT">
                                        <Region styleClass="progress-fill-blue"
                                                prefHeight="5.0"
                                                fx:id="budgetBarTransport"/>
                                    </StackPane>
                                    <VBox.margin><Insets bottom="8.0"/></VBox.margin>
                                </VBox>

                                <!-- Shopping -->
                                <VBox spacing="5.0">
                                    <HBox>
                                        <Label styleClass="budget-name" text="Shopping" HBox.hgrow="ALWAYS"/>
                                        <Label styleClass="budget-value" text="Rs.5,400 / Rs.5,000"/>
                                    </HBox>
                                    <StackPane styleClass="progress-track" alignment="CENTER_LEFT">
                                        <Region styleClass="progress-fill-red"
                                                prefHeight="5.0"
                                                fx:id="budgetBarShopping"/>
                                    </StackPane>
                                    <VBox.margin><Insets bottom="8.0"/></VBox.margin>
                                </VBox>

                                <!-- Entertainment -->
                                <VBox spacing="5.0">
                                    <HBox>
                                        <Label styleClass="budget-name" text="Entertainment" HBox.hgrow="ALWAYS"/>
                                        <Label styleClass="budget-value" text="Rs.800 / Rs.2,000"/>
                                    </HBox>
                                    <StackPane styleClass="progress-track" alignment="CENTER_LEFT">
                                        <Region styleClass="progress-fill-green"
                                                prefHeight="5.0"
                                                fx:id="budgetBarEntertainment"/>
                                    </StackPane>
                                    <VBox.margin><Insets bottom="8.0"/></VBox.margin>
                                </VBox>

                                <!-- Utilities -->
                                <VBox spacing="5.0">
                                    <HBox>
                                        <Label styleClass="budget-name" text="Utilities" HBox.hgrow="ALWAYS"/>
                                        <Label styleClass="budget-value" text="Rs.1,600 / Rs.2,500"/>
                                    </HBox>
                                    <StackPane styleClass="progress-track" alignment="CENTER_LEFT">
                                        <Region styleClass="progress-fill-purple"
                                                prefHeight="5.0"
                                                fx:id="budgetBarUtilities"/>
                                    </StackPane>
                                </VBox>

                            </VBox>

                        </HBox>

                        <!-- Bottom padding -->
                        <Region prefHeight="8.0"/>

                    </VBox>
                </content>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>
